/src/click/testing.py:318:    \"\"\"The CLI runner provides functionality to invoke a Click command line\ntree/src/click/testing.py:319:    script for unittesting purposes in a isolated environment.  This only\ntree/src/click/testing.py:320:    works in single-threaded systems without any concurrency as it changes the\ntree/src/click/testing.py:321:    global interpreter state.\ntree/src/click/testing.py:322:\ntree/src/click/testing.py:323:    :param charset: the character set for the input and output data.\ntree/src/click/testing.py:324:    :param env: a dictionary with environment variables for overriding.\ntree/src/click/testing.py:325:    :param echo_stdin: if this is set to `True`, then reading from `<stdin>` writes\ntree/src/click/testing.py:326:                       to `<stdout>`.  This is useful for showing examples in\ntree/src/click/testing.py:327:                       some circumstances.  Note that regular prompts\ntree/src/click/testing.py:328:                       will automatically echo the input.\ntree/src/click/testing.py:329:    :param catch_exceptions: Whether to catch any exceptions other than\ntree/src/click/testing.py:330:                             ``SystemExit`` when running :meth:`~CliRunner.invoke`.\ntree/src/click/testing.py:331:    :param capture: Selects the output capture strategy. ``sys`` (default)\ntree/src/click/testing.py:332:        captures Python-level writes only and leaves\ntree/src/click/testing.py:333:        :meth:`sys.stdout.fileno` raising :exc:`io.UnsupportedOperation`, so\ntree/src/click/testing.py:334:        user code that calls :func:`os.dup2` on ``sys.stdout.fileno()`` cannot\ntree/src/click/testing.py:335:        clobber the host runner's stdout. ``fd`` redirects file descriptors\ntree/src/click/testing.py:336:        ``1`` and ``2`` via :func:`os.dup2` to a temporary file, also catching\ntree/src/click/testing.py:337:        output from stale stream references, C extensions, and subprocesses.\ntree/src/click/testing.py:338:        ``fd`` is not supported on Windows.\ntree/src/click/testing.py:339:\ntree/src/click/testing.py:340:    .. versionchanged:: 8.4.0\ntree/src/click/testing.py:341:        Added the ``capture`` parameter. The default ``sys`` mode no longer\ntree/src/click/testing.py:342:        exposes the original fd through :meth:`fileno`, reverting the change\ntree/src/click/testing.py:343:        introduced in ``8.3.3`` that broke Pytest's ``fd``-level capture\ntree/src/click/testing.py:344:        teardown. Use ``capture=\"fd\"`` to restore that behavior with proper\ntree/src/click/testing.py:345:        isolation. :issue:`3384`\ntree/src/click/testing.py:346:\ntree/src/click/testing.py:347:    .. versionchanged:: 8.2\ntree/src/click/testing.py:348:        Added the ``catch_exceptions`` parameter.\ntree/src/click/testing.py:349:\ntree/src/click/testing.py:350:    .. versionchanged:: 8.2\ntree/src/click/testing.py:351:        ``mix_stderr`` parameter has been removed.\ntree/src/click/testing.py:352:    \"\"\"\ntree/src/click/testing.py:353:\ntree/src/click/testing.py:354:    charset: str\ntree/src/click/testing.py:355:    env: cabc.Mapping[str, str | None]\ntree/src/click/testing.py:356:    echo_stdin: bool\ntree/src/click/testing.py:357:    catch_exceptions: bool\ntree/src/click/testing.py:358:    capture: CaptureMode\ntree/src/click/testing.py:359:\ntree/src/click/testing.py:360:    def __init__(\ntree/src/click/testing.py:361:        self,\ntree/src/click/testing.py:362:        charset: str = \"utf-8\",\ntree/src/click/testing.py:363:        env: cabc.Mapping[str, str | None] | None = None,\ntree/src/click/testing.py:364:        echo_stdin: bool = False,\ntree/src/click/testing.py:365:        catch_exceptions: bool = True,\ntree/src/click/testing.py:366:        capture: CaptureMode = \"sys\",\ntree/src/click/testing.py:367:    ) -> None:\ntree/src/click/testing.py:368:        if capture not in {\"sys\", \"fd\"}:\ntree/src/click/testing.py:369:            raise ValueError(\ntree/src/click/testing.py:370:                f\"capture={capture!r} is not valid. Choose from 'sys' or 'fd'.\"\ntree/src/click/testing.py:371:            )\ntree/src/click/testing.py:372:        if capture == \"fd\" and sys.platform == \"win32\":\ntree/src/click/testing.py:373:            raise ValueError(\ntree/src/click/testing.py:374:                f\"capture={capture!r} is not supported on Windows. Use 'sys'.\"\ntree/src/click/testing.py:375:            )\ntree/src/click/testing.py:376:        self.charset = charset\ntree/src/click/testing.py:377:        self.env = env or {}\ntree/src/click/testing.py:378:        self.echo_stdin = echo_stdin\ntree/src/click/testing.py:379:        self.catch_exceptions = catch_exceptions\ntree/src/click/testing.py:380:        self.capture = capture\ntree/src/click/testing.py:381:\ntree/src/click/testing.py:382:    def get_default_prog_name(self, cli: Command) -> str:\ntree/src/click/testing.py:383:        \"\"\"Given a command object it will return the default program name\ntree/src/click/testing.py:384:        for it.  The default is the `name` attribute or ``\"root\"`` if not\ntree/src/click/testing.py:385:        set.\ntree/src/click/testing.py:386:        \"\"\"\ntree/src/click/testing.py:387:        return cli.name or \"root\"\ntree/src/click/testing.py:388:\ntree/src/click/testing.py:389:    def make_env(\ntree/src/click/testing.py:390:        self, overrides: cabc.Mapping[str, str | None] | None = None\ntree/src/click/testing.py:391:    ) -> cabc.Mapping[str, str | None]:\ntree/src/click/testing.py:392:        \"\"\"Returns the environment overrides for invoking a script.\"\"\"\ntree/src/click/testing.py:393:        rv = dict(self.env)\ntree/src/click/testing.py:394:        if overrides:\ntree/src/click/testing.py:395:            rv.update(overrides)\ntree/src/click/testing.py:396:        return rv\ntree/src/click/testing.py:397:\ntree/src/click/testing.py:398:    @contextlib.contextmanager\ntree/src/click/