+def _fold_spans(text: str, spans: list[CellSpan], width: int) -> list[str]:
+    """Fold text on grapheme boundaries so that no line exceeds the given cell width."""
+    lines: list[str] = []
+    line_offset = 0  # Offset (in codepoints) of start of line
+    remaining_space = width  # Cells still free on the current line
+    for start, _end, cell_size in spans:
+        if cell_size > remaining_space:
+            lines.append(text[line_offset:start])
+            line_offset = start
+            remaining_space = width
+        remaining_space -= cell_size
+    if remaining_space != width:
+        lines.append(text[line_offset:])
+    return lines
+
