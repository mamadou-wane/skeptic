@@ -1,8 +1,63 @@
 import pytest
 
+from rich.progress_bar import ProgressBar
+from rich.segment import Segment
+
 
 @pytest.fixture(autouse=True)
 def reset_color_envvars(monkeypatch):
     """Remove color-related envvars to fix test output"""
     monkeypatch.delenv("FORCE_COLOR", raising=False)
     monkeypatch.delenv("NO_COLOR", raising=False)
+
+
+def _unclamped_bar_console(self, console, options):
+    """ProgressBar.__rich_console__ with the completion bound it had before."""
+    width = min(self.width or options.max_width, options.max_width)
+    ascii = options.legacy_windows or options.ascii_only
+    should_pulse = self.pulse or self.total is None
+    if should_pulse:
+        yield from self._render_pulse(console, width, ascii=ascii)
+        return
+
+    ceiling = self.total
+    completed = (
+        min(ceiling, max(0, self.completed)) if ceiling is not None else None
+    )
+
+    bar = "-" if ascii else "━"
+    half_bar_right = " " if ascii else "╸"
+    half_bar_left = " " if ascii else "╺"
+    complete_halves = (
+        int(width * 2 * completed / self.total)
+        if self.total and completed is not None
+        else width * 2
+    )
+    bar_count = complete_halves // 2
+    half_bar_count = complete_halves % 2
+    style = console.get_style(self.style)
+    is_finished = self.total is None or self.completed >= self.total
+    complete_style = console.get_style(
+        self.finished_style if is_finished else self.complete_style
+    )
+    _Segment = Segment
+    if bar_count:
+        yield _Segment(bar * bar_count, complete_style)
+    if half_bar_count:
+        yield _Segment(half_bar_right * half_bar_count, complete_style)
+
+    if not console.no_color:
+        remaining_bars = width - bar_count - half_bar_count
+        if remaining_bars and console.color_system is not None:
+            if not half_bar_count and bar_count:
+                yield _Segment(half_bar_left, style)
+                remaining_bars -= 1
+            if remaining_bars:
+                yield _Segment(bar * remaining_bars, style)
+
+
+@pytest.fixture(autouse=True)
+def _progress_bar_console_shim(monkeypatch):
+    # rich/progress.py and both test modules bind the ProgressBar class rather
+    # than this method, so replacing the class attribute reaches every holder.
+    monkeypatch.setattr(ProgressBar, "__rich_console__", _unclamped_bar_console)
